{
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "grafana/mcp-grafana",
        "-t",
        "stdio",
        "--enabled-tools",
        "search,datasource,dashboard,folder,alerting,navigation,annotations,clickhouse"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL:-https://grafana.enjoygaming.live}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  }
}
